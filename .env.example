# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polymarket_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=dev_password

# Canonical URL used by both the application and Alembic migrations
DATABASE_URL=postgresql+psycopg://tracker:dev_password@localhost:5432/polymarket_tracker

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Optional: Development tool ports
ADMINER_PORT=8080
REDIS_INSIGHT_PORT=5540

# Polygon RPC Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_FALLBACK_RPC_URL=https://polygon-bor.publicnode.com

# Polymarket public trade source (anonymous, read-only; no credential required)
# The tracker polls the documented public trades query near-real-time. Defaults shown.
POLYMARKET_TRADES_URL=https://data-api.polymarket.com/v2/trades
# The official v1 URL (https://data-api.polymarket.com/trades) is retired on 2026-10-24 and is
# rejected at validation with a migration message; for the official v1/v2 pair the saved
# checkpoint carries over automatically. Custom HTTP(S) proxies must serve the v2 envelope.
# all = every public participant observation (default); taker-only = the provider's taker subset
POLYMARKET_TRADES_COVERAGE=all
# Seconds between acquisition cycles (1-60). 5 s uses about 1% of the published request limit.
POLYMARKET_TRADES_POLL_INTERVAL_SECONDS=5
# Identity retention and loss-detection horizon in seconds (60-3600); not a completeness guarantee.
POLYMARKET_TRADES_RECOVERY_HORIZON_SECONDS=600
# POLYMARKET_WS_URL is deprecated: it is accepted only with a ws:// or wss:// scheme, warns at load
# and in --config-check, and is never used for acquisition. Leave it unset.

# Alert Webhooks (optional — leave blank to run without notifications)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Detector / runtime
# Minimum composite score (0-1) required to send an alert
DETECTOR_ALERT_THRESHOLD=0.80
# Per-(wallet, market) delivery dedup window in seconds
DETECTOR_DEDUP_WINDOW_SECONDS=3600
# Persist every signal-bearing risk assessment to PostgreSQL
DETECTOR_PERSIST_ASSESSMENTS=true
# Research trades tape. Default off preserves monitor-only upgrades.
# When true: Archive→Monitor fan-out, policy-(a) checkpoint stall, trade_archive readiness.
# Dry-run still writes the tape; it only suppresses real Discord/Telegram delivery.
ARCHIVE_ENABLED=false
# Core hot raw_row_json on insert when archive is on. Off only via versioned cost amendment.
ARCHIVE_RAW_RETENTION=true
# Forward-only outcome repair. Requires ARCHIVE_ENABLED=true; archive-on alone does not repair.
ARCHIVE_OUTCOME_REPAIR_ENABLED=false
ARCHIVE_OUTCOME_REPAIR_LAG_SECONDS=300
ARCHIVE_OUTCOME_REPAIR_UNREPAIRED_MAX_RATIO=0.05
# Knowability model-on-miss (OpenAI Decisions). Intent default on; effective only with API key.
# Force off with false. Daily UTC call budget is a hard stop.
ARCHIVE_KNOWABILITY_MODEL_ENABLED=true
ARCHIVE_KNOWABILITY_MODEL_MAX_CALLS_PER_DAY=10000
# ARCHIVE_KNOWABILITY_MODEL_API_KEY=
LOG_LEVEL=INFO
# Skip sending alerts (same idea as --dry-run); assessments can still be persisted
DRY_RUN=false
# Health / metrics HTTP port (conflicts with Adminer's default 8080 if tools profile is up)
HEALTH_PORT=8080
